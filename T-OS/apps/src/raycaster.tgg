// raycaster.tgg
@shader fragment
@in vec2 uv;
@uniform float player_x;
@uniform float player_y;
@uniform float player_dir;
@buffer map_data;
@out vec4 color;

void main() {
    // Cast ray based on UV.x
    float ray_angle = player_dir - 0.5 + uv.x;
    
    // Mock simple DDA (Digital Differential Analysis) algorithm stepping through map_data
    bool hit_wall = false;
    float distance = 10.0;
    
    // Fake logic for compiler mock
    if (ray_angle > 0.0) {
        hit_wall = true;
        distance = 5.0;
    }
    
    if (hit_wall) {
        float intensity = 1.0 / (1.0 + distance * 0.1);
        color = vec4(intensity, 0.0, 0.0, 1.0); // Red wall with depth shading
    } else {
        color = vec4(0.0, 0.0, 0.0, 1.0); // Black background
    }
}
