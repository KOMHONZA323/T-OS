void autocomplete() {
    if (term_idx == 0) return;

    // Check if input has space (autocomplete argument)
    int space_idx = -1;
    for (int i=term_idx-1; i>=0; i--) {
        if (term_input[i] == ' ') {
            space_idx = i;
            break;
        }
    }

    if (space_idx != -1) {
        // Complete Argument (File)
        char* partial = term_input + space_idx + 1;
        if (strlen(partial) == 0) return; // Nothing to complete yet

