#ifndef STD_GLH
#define STD_GLH

#define NULL ((void*)0)

// Standard Types (assumed to be built-in by tgc)
// int: 32-bit signed integer
// char: 8-bit signed integer
// void: empty type

// Standard I/O
void print(char* message);
char get_char();

// System
void exit();
void sleep(int ms);

// Window Management
// Returns window ID on success, -1 on failure
int os_create_window(int width, int height, char* title);

// Process Management
// Returns process ID on success, -1 on failure
int os_spawn_process(char* filename);

// Memory Management
void* malloc(int size);
void free(void* ptr);

// File I/O
// Using standard C style
// Returns file descriptor or -1 on error
int open(char* filename, int flags);
int read(int fd, void* buf, int count);
int write(int fd, void* buf, int count);
int close(int fd);

// Flags for open (simplified)
#define O_RDONLY 0
#define O_WRONLY 1
#define O_RDWR   2
#define O_CREAT  4

#endif
